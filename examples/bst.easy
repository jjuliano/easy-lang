¤ Height counts nodes on the longest path. A leaf has height 1.
¤ Inserting 1, then 2, then 3 makes a chain of height 3.
¤ Inserting 2, then 1, then 3 makes a balanced tree of height 2.

node(info, left, right)

procedure Insert(root, x)
if root = nil then [
  call GETNODE(p)
  info(p) ← x
  left(p) ← nil
  right(p) ← nil
  root ← p
] else if x < info(root) then call Insert(left(root), x)
else call Insert(right(root), x)
end Insert

procedure Height(p, lh, rh)
if p = nil then return(0)
lh ← Height(left(p), 0, 0)
rh ← Height(right(p), 0, 0)
if lh > rh then return(lh + 1)
else return(rh + 1)
end Height

procedure Grow(root, x, y, z)
root ← nil
call Insert(root, x)
call Insert(root, y)
call Insert(root, z)
end Grow

procedure MAIN
root ← nil
call Grow(root, 1, 2, 3)
output Height(root, 0, 0)
root ← nil
call Grow(root, 2, 1, 3)
output Height(root, 0, 0)
end MAIN
