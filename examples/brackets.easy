¤ An opener waits on the pile. A closer must match the most recent opener.

procedure Match(open, close)
if open = "(" and close = ")" then return(true)
if open = "[" and close = "]" then return(true)
return(false)
end Match

procedure Balanced(s, n)
array s(1:n)
array pile(1:n)
top ← 0
i ← 1
while i <= n do
  ch ← s(i)
  if ch = "(" or ch = "[" then [
    top ← top + 1
    pile(top) ← ch
  ] else [
    if top = 0 then return(false)
    if Match(pile(top), ch) = false then return(false)
    top ← top - 1
  ]
  i ← i + 1
endwhile
return(top = 0)
end Balanced

procedure MAIN
array good(1:4)
good(1) ← "("
good(2) ← "["
good(3) ← "]"
good(4) ← ")"
array bad(1:4)
bad(1) ← "("
bad(2) ← "["
bad(3) ← ")"
bad(4) ← "]"
output Balanced(good, 4)
output Balanced(bad, 4)
end MAIN
