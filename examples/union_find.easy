¤ Three names, each a parent of itself until a union. Find walks to the root.

procedure Find(parent, x)
array parent(1:3)
while parent(x) ≠ x do
  x ← parent(x)
endwhile
return(x)
end Find

procedure Unite(parent, a, b)
array parent(1:3)
ra ← Find(parent, a)
rb ← Find(parent, b)
if ra ≠ rb then parent(rb) ← ra
end Unite

procedure MAIN
array parent(1:3)
parent(1) ← 1
parent(2) ← 2
parent(3) ← 3
call Unite(parent, 1, 2)
output Find(parent, 1)
output Find(parent, 2)
output Find(parent, 3)
end MAIN
