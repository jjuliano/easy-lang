¤ Three towns. A to B costs 1, A to C costs 10, B to C costs 2.
¤ The short path from A to C costs 3. The spanning tree keeps 1 and 2, and refuses 9.

procedure Shortest(w, dist)
array w(1:3, 1:3)
array dist(1:3)
array used(1:3)
i ← 1
while i <= 3 do
  used(i) ← false
  i ← i + 1
endwhile
round ← 1
while round <= 3 do
  best ← 0
  bi ← 0
  i ← 1
  while i <= 3 do
    if used(i) = false and (bi = 0 or dist(i) < best) then [
      best ← dist(i)
      bi ← i
    ]
    i ← i + 1
  endwhile
  used(bi) ← true
  j ← 1
  while j <= 3 do
    if w(bi, j) ≠ 0 and dist(bi) + w(bi, j) < dist(j) then dist(j) ← dist(bi) + w(bi, j)
    j ← j + 1
  endwhile
  round ← round + 1
endwhile
end Shortest

procedure Find(parent, x)
array parent(1:3)
while parent(x) ≠ x do
  x ← parent(x)
endwhile
return(x)
end Find

procedure MAIN
array w(1:3, 1:3)
r ← 1
while r <= 3 do
  c ← 1
  while c <= 3 do
    w(r, c) ← 0
    c ← c + 1
  endwhile
  r ← r + 1
endwhile
w(1, 2) ← 1
w(1, 3) ← 10
w(2, 3) ← 2
array dist(1:3)
dist(1) ← 0
dist(2) ← 999
dist(3) ← 999
call Shortest(w, dist)
output dist(3)
array parent(1:3)
parent(1) ← 1
parent(2) ← 2
parent(3) ← 3
total ← 0
¤ Edges already in increasing cost: 1-2 costs 1, 2-3 costs 2, 1-3 costs 9.
a ← Find(parent, 1)
b ← Find(parent, 2)
if a ≠ b then [
  parent(b) ← a
  total ← total + 1
]
a ← Find(parent, 2)
b ← Find(parent, 3)
if a ≠ b then [
  parent(b) ← a
  total ← total + 2
]
a ← Find(parent, 1)
b ← Find(parent, 3)
if a ≠ b then total ← total + 9
output total
end MAIN
