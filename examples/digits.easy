¤ Digits sit low to high. 99 is 9, 9. Adding 1 yields 0, 0, 1.

procedure Add(a, na, b, nb, c, nc)
array a(1:na)
array b(1:nb)
array c(1:na + 1)
i ← 1
carry ← 0
while i <= na or i <= nb or carry ≠ 0 do
  da ← 0
  db ← 0
  if i <= na then da ← a(i)
  if i <= nb then db ← b(i)
  sum ← da + db + carry
  c(i) ← sum mod 10
  carry ← floor(sum / 10)
  i ← i + 1
endwhile
nc ← i - 1
end Add

procedure MAIN
array a(1:2)
a(1) ← 9
a(2) ← 9
array b(1:1)
b(1) ← 1
array c(1:3)
nc ← 0
call Add(a, 2, b, 1, c, nc)
output c(1) c(2) c(3)
end MAIN
