¤ A sorted table. Linear search walks from the left. Binary search halves the range.
¤ Both return the index of 7, which is 3, and 0 when 3 is absent.

procedure Linear(a, n, key)
array a(1:n)
i ← 1
while i <= n do
  if a(i) = key then return(i)
  i ← i + 1
endwhile
return(0)
end Linear

procedure Binary(a, n, key)
array a(1:n)
lo ← 1
hi ← n
while lo <= hi do
  mid ← floor((lo + hi) / 2)
  case
  : key = a(mid): return(mid)
  : key > a(mid): lo ← mid + 1
  : else: hi ← mid - 1
  endcase
endwhile
return(0)
end Binary

procedure MAIN
array row(1:5)
row(1) ← 2
row(2) ← 4
row(3) ← 7
row(4) ← 9
row(5) ← 11
output Linear(row, 5, 7)
output Linear(row, 5, 3)
output Binary(row, 5, 7)
output Binary(row, 5, 3)
end MAIN
